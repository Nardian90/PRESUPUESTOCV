# =========================================================
# PRESUPUESTO CCTV v2.0 — Variables de entorno (SIN secretos reales)
# =========================================================
# En despliegues con servidor (Node/Next/Docker), defina aquí la
# contraseña de acceso y cárguela como secreto del entorno.
# En modo estático (GitHub Pages / file://), la contraseña se gestiona
# con hash SHA-256 y puede cambiarse desde: Configuración Económica
# > "Seguridad de acceso".

APP_PASSWORD=your_secure_password_here

# Modo de autenticación: static (por defecto) | server
AUTH_MODE=static

# Duración de la sesión en horas
SESSION_TTL_HOURS=12
